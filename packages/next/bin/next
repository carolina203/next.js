#!/bin/sh
# Resolve symlinks to get the real directory (handles node_modules/.bin symlinks)
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  DIR="$(dirname "$SCRIPT")"
  SCRIPT="$(readlink "$SCRIPT")"
  # Handle relative symlinks
  [ "${SCRIPT#/}" = "$SCRIPT" ] && SCRIPT="$DIR/$SCRIPT"
done
DIR="$(dirname "$SCRIPT")"

# Development: local binary
[ -x "$DIR/next-native" ] && exec "$DIR/next-native" "$@"

# Production: check installed @next/cli-* package (hoisted to node_modules/@next/cli-*)
for pkg in "$DIR"/../../@next/cli-*/next; do
  [ -x "$pkg" ] && exec "$pkg" "$@"
done

# Fallback: Node.js
exec node "$DIR/../dist/bin/next" "$@"
